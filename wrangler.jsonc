{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frg-site",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  // `main` and `assets` are filled in by the Cloudflare adapter during
  // `astro build`: the generated deployment config lands in
  // `dist/server/wrangler.json` and is what gets uploaded.
  //
  //   npm run deploy
  //
  // Secrets (Turnstile, Resend) are set with `wrangler secret put <NAME>`.

  "routes": [
    {
      "pattern": "fundacionrosariogaton.org",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true,
  },
  "vars": {
    "MEDIA_BASE_URL": "https://media.fundacionrosariogaton.org",
    "R2_PUBLIC_URL": "https://media.fundacionrosariogaton.org"
  },
}
