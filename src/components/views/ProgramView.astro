---
/**
 * The detail page of a program of the `programs` collection.
 *
 * The header and the cover come from the frontmatter; the body is optional
 * Markdown that the foundation can write whenever it has more to say about a
 * program. The page also lists the news of the program's category (when it
 * names one), the ways to help, and the rest of the programs.
 */
import { render } from 'astro:content';

import TranslationNotice from './TranslationNotice.astro';
import { getUi } from '~/lib/ui.ts';
import { localePath, type Locale } from '~/lib/locales.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getPostsByCategory, getPrograms, type ProgramEntry } from '~/lib/content.ts';
import { donatePath } from '~/lib/navigation.ts';

interface Props {
  program: ProgramEntry;
  locale: Locale;
  isFallback: boolean;
}

const { program, locale, isFallback } = Astro.props;
const ui = getUi(locale);

const hasBody = (program.body ?? '').trim().length > 0;
const Content = hasBody ? (await render(program)).Content : undefined;

const indexHref = localePath(locale, 'programas-y-proyectos');
const programHref = (slug: string): string =>
  localePath(locale, `programas-y-proyectos/${slug}`);

const related = program.data.category
  ? (await getPostsByCategory(locale, program.data.category)).slice(0, 3)
  : [];
const others = (await getPrograms(locale)).filter(
  (entry) => entry.data.slug !== program.data.slug,
);
---

{isFallback && <TranslationNotice locale={locale} />}

<article>
  <header class="section-sweep">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div>
        <a
          href={indexHref}
          class="inline-flex items-center gap-2 font-display text-sm font-medium text-accent hover:text-accent-hover"
        >
          <span aria-hidden="true">←</span>
          <span class="link-underline">{ui.programsBack}</span>
        </a>
        <h1 class="mt-5 text-display-lg">{program.data.title}</h1>
        {program.data.summary && (
          <p class="mt-5 text-lg leading-relaxed text-secondary">
            {program.data.summary}
          </p>
        )}
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={donatePath(locale)} class="btn-donate">
            {ui.donate}
          </a>
          <a href={localePath(locale, 'voluntariado')} class="btn-outline">
            {ui.programVolunteer}
          </a>
        </div>
      </div>

      {program.data.image && (
        <img
          src={mediaUrl(program.data.image)}
          alt={program.data.imageAlt ?? program.data.title}
          loading="eager"
          decoding="async"
          class="aspect-[4/3] w-full rounded-3xl object-cover shadow-md"
        />
      )}
    </div>
  </header>

  {Content && (
    <section class="section">
      <div class="container-site">
        <div class="prose prose-frg mx-auto max-w-3xl">
          <Content />
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container-site">
        <h2 class="text-display-md">{ui.programRelatedNews}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((post) => (
            <a
              href={localePath(locale, `actualidades/${post.data.slug}`)}
              class="card group flex flex-col overflow-hidden p-0"
            >
              {post.data.image && (
                <img
                  src={mediaUrl(post.data.image)}
                  alt={post.data.imageAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                  class="h-44 w-full object-cover"
                />
              )}
              <div class="p-6">
                <time
                  datetime={post.data.date.toISOString()}
                  class="font-alt text-xs uppercase tracking-[0.14em] text-secondary"
                >
                  {post.data.date.toLocaleDateString(locale, {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h3 class="mt-3 font-display text-lg font-semibold transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-brand-navy py-16 md:py-20">
    <div class="container-site flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-display-sm text-white md:text-display-md">
          {ui.programCtaTitle}
        </h2>
        <p class="mt-3 text-lg text-white/90">{ui.programCtaText}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={donatePath(locale)} class="btn-donate">
          {ui.donate}
        </a>
        <a href={localePath(locale, 'voluntariado')} class="btn-white">
          {ui.programVolunteer}
        </a>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section">
      <div class="container-site">
        <h2 class="text-display-md">{ui.programOthers}</h2>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((entry) => (
            <li>
              <a
                href={programHref(entry.data.slug)}
                class="flex h-full items-center justify-between gap-4 rounded-2xl border border-accent/15 px-5 py-4 font-display font-medium text-secondary transition-colors hover:border-accent hover:text-accent"
              >
                <span>{entry.data.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</article>
