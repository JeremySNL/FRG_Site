---
/**
 * A notice shown when a page is served in a language it has not been
 * translated into yet. The content itself is the Spanish original.
 */
import { getUi } from '~/lib/ui.ts';
import type { Locale } from '~/lib/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<aside
  class="border-b border-muted bg-transition/30"
  role="status"
  aria-live="polite"
>
  <div class="container-site py-4">
    <p class="text-sm text-secondary">
      <strong class="font-display font-semibold text-heading">
        {ui.translationPendingTitle}.
      </strong>{' '}
      {ui.translationPendingText}
    </p>
  </div>
</aside>
