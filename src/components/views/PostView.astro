---
/**
 * Renders a post of the `posts` collection: the header, the body and the
 * taxonomy links.
 */
import { render } from 'astro:content';

import TranslationNotice from './TranslationNotice.astro';
import { getUi } from '~/lib/ui.ts';
import { localePath, type Locale } from '~/lib/locales.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getCategories, getTags, type PostEntry } from '~/lib/content.ts';

interface Props {
  post: PostEntry;
  locale: Locale;
  isFallback: boolean;
}

const { post, locale, isFallback } = Astro.props;
const ui = getUi(locale);
const { Content } = await render(post);

const categories = await getCategories(locale);
const tags = await getTags(locale);

const categoryTitle = (slug: string): string =>
  categories.find((entry) => entry.data.slug === slug)?.data.title ?? slug;
const tagTitle = (slug: string): string =>
  tags.find((entry) => entry.data.slug === slug)?.data.title ?? slug;
---

{isFallback && <TranslationNotice locale={locale} />}

<article class="section">
  <div class="container-site">
    <div class="mx-auto max-w-3xl">
      <header>
        <time
          datetime={post.data.date.toISOString()}
          class="font-alt text-xs uppercase tracking-[0.16em] text-secondary"
        >
          {ui.publishedOn} {post.data.date.toLocaleDateString(locale, {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>

        <h1 class="mt-3 text-display-lg">{post.data.title}</h1>

        {
          post.data.excerpt && (
            <p class="mt-5 text-lg leading-relaxed text-secondary">
              {post.data.excerpt}
            </p>
          )
        }
      </header>

      {
        post.data.image && (
          <img
            src={mediaUrl(post.data.image)}
            alt={post.data.imageAlt ?? ''}
            loading="eager"
            decoding="async"
            class="mt-10 w-full rounded-3xl object-cover shadow-md"
          />
        )
      }

      <div class="prose prose-frg mt-10">
        <Content />
      </div>

      {
        (post.data.categories.length > 0 || post.data.tags.length > 0) && (
          <footer class="mt-12 border-t border-muted pt-6">
            {post.data.categories.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-display text-sm font-medium">
                  {ui.categories}:
                </span>
                {post.data.categories.map((slug) => (
                  <a
                    href={localePath(locale, `category/${slug}`)}
                    class="rounded-pill bg-surface px-4 py-1.5 text-xs transition-colors hover:bg-accent hover:text-white"
                  >
                    {categoryTitle(slug)}
                  </a>
                ))}
              </div>
            )}

            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="font-display text-sm font-medium">{ui.tags}:</span>
                {post.data.tags.map((slug) => (
                  <a
                    href={localePath(locale, `tag/${slug}`)}
                    class="rounded-pill bg-surface px-4 py-1.5 text-xs transition-colors hover:bg-accent hover:text-white"
                  >
                    {tagTitle(slug)}
                  </a>
                ))}
              </div>
            )}
          </footer>
        )
      }
    </div>
  </div>
</article>
