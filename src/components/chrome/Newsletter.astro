---
/**
 * The newsletter sign-up form in the footer.
 *
 * It posts to `/api/newsletter` and reports the result inline, without a page
 * reload.
 */
import { getUi } from '~/lib/ui.ts';
import type { Locale } from '~/lib/locales.ts';
import { turnstileSiteKey } from '~/lib/turnstile-config.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const siteKey = turnstileSiteKey;
---

<form
  id="newsletter-form"
  class="space-y-4"
  method="post"
  action="/api/newsletter/"
  data-success={ui.newsletterSuccess}
  data-error={ui.newsletterError}
  data-invalid-token={ui.form.invalidToken}
>
  <h2 class="font-display text-lg font-semibold">{ui.newsletterTitle}</h2>
  <p class="text-sm text-white/70">{ui.newsletterText}</p>

  <div class="flex flex-col gap-3 sm:flex-row">
    <label class="sr-only" for="newsletter-email">
      {ui.newsletterPlaceholder}
    </label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder={ui.newsletterPlaceholder}
      class="w-full rounded-pill border border-white/20 bg-transparent px-5 py-3 text-sm text-white placeholder:text-white/50 focus:border-white focus:outline-none"
    />
    <button type="submit" class="btn-white btn-sm shrink-0">
      {ui.newsletterSubmit}
    </button>
  </div>

  {siteKey && (
    <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>
  )}

  <!-- Honeypot: real users never fill this in. -->
  <div class="hidden" aria-hidden="true">
    <label for="newsletter-website">Website</label>
    <input
      id="newsletter-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <p
    id="newsletter-status"
    class="min-h-5 text-sm"
    role="status"
    aria-live="polite"
  ></p>
</form>

{siteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
)}

<script>
  const form = document.querySelector<HTMLFormElement>('#newsletter-form');
  const status = document.querySelector<HTMLElement>('#newsletter-status');

  if (form && status) {
    // The messages come from the i18n string table, rendered into the form's
    // data attributes by the server, so every locale gets its own copy
    // without a dict in the client bundle.
    const okMessage = form.dataset.success ?? '';
    const errorMessage = form.dataset.error ?? '';
    const invalidTokenMessage = form.dataset.invalidToken ?? errorMessage;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const token = data.get('cf-turnstile-response');
      if (typeof token === 'string' && token) data.set('turnstileToken', token);

      if (button) button.disabled = true;
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { accept: 'application/json' },
        });

        const result = (await response.json()) as { ok?: boolean; error?: string };
        status.textContent = result.ok
          ? okMessage
          : result.error === 'invalid-token'
            ? invalidTokenMessage
            : errorMessage;
        status.classList.toggle('text-white', result.ok === true);
        status.classList.toggle('text-accent-hover', result.ok !== true);

        if (result.ok) form.reset();
      } catch {
        status.textContent = errorMessage;
        status.classList.add('text-accent-hover');
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
