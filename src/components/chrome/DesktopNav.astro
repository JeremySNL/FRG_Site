---
/**
 * The desktop main navigation. Submenus open on hover and on keyboard focus
 * (CSS) and also from a chevron button, so touch screens wide enough for this
 * menu can reach them.
 */
import { getUi } from '~/lib/ui.ts';
import type { Locale } from '~/lib/locales.ts';
import type { NavItem } from '~/lib/navigation.ts';

interface Props {
  locale: Locale;
  nav: NavItem[];
  /** The current pathname, used to mark the active item. */
  currentPath: string;
}

const { locale, nav, currentPath } = Astro.props;
const ui = getUi(locale);

const isActive = (href: string): boolean =>
  href === currentPath || (href !== '/' && currentPath.startsWith(href));
const isItemActive = (item: NavItem): boolean =>
  isActive(item.href) || item.children.some((child) => isActive(child.href));
---

<nav class="hidden lg:block" aria-label={ui.mainMenu}>
  <ul class="flex items-center gap-1">
    {nav.map((item, index) => (
      <li class="group relative flex items-center" data-nav-item>
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'inline-flex items-center rounded-pill py-2 font-display text-sm font-medium text-secondary transition-colors hover:bg-tint hover:text-accent',
            item.children.length > 0 ? 'pl-4 pr-1' : 'px-4',
            isItemActive(item) && 'bg-tint font-semibold text-accent',
          ]}
        >
          {item.label}
        </a>
        {item.children.length > 0 && (
          <button
            type="button"
            data-submenu-toggle
            aria-expanded="false"
            aria-controls={`submenu-${index}`}
            aria-label={`${item.label}: ${ui.openSubmenu}`}
            class="inline-flex size-8 items-center justify-center rounded-pill text-secondary transition-colors hover:bg-tint hover:text-accent"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 20 20"
              class="size-3.5 fill-current opacity-60"
            >
              <path d="M5.5 7.5 10 12l4.5-4.5H5.5Z" />
            </svg>
          </button>
        )}

        {item.children.length > 0 && (
          <div
            id={`submenu-${index}`}
            class="invisible absolute left-0 top-full z-50 w-64 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 group-data-[open]:visible group-data-[open]:opacity-100"
          >
            <ul class="rounded-2xl border border-accent/10 bg-white p-2 shadow-lg shadow-accent/10">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    aria-current={isActive(child.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-xl px-4 py-2 text-sm text-secondary transition-colors hover:bg-tint hover:text-accent',
                      isActive(child.href) && 'bg-tint font-medium text-accent',
                    ]}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </li>
    ))}
  </ul>
</nav>

<script>
  // Submenus open on hover and keyboard focus (CSS), and also with the chevron
  // button, so touch screens that are wide enough for the desktop menu can
  // reach them. Escape or a click elsewhere closes them.
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]'));

  const closeAll = (except?: HTMLElement) => {
    for (const item of items) {
      if (item === except) continue;
      item.removeAttribute('data-open');
      item
        .querySelector('[data-submenu-toggle]')
        ?.setAttribute('aria-expanded', 'false');
    }
  };

  for (const item of items) {
    const button = item.querySelector<HTMLButtonElement>('[data-submenu-toggle]');
    button?.addEventListener('click', () => {
      const open = item.toggleAttribute('data-open');
      button.setAttribute('aria-expanded', String(open));
      closeAll(item);
    });
  }

  document.addEventListener('click', (event) => {
    if (
      !(event.target instanceof Element) ||
      !event.target.closest('[data-nav-item]')
    ) {
      closeAll();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeAll();
    // `:focus-within` keeps a submenu visible while one of its controls has
    // the focus, so release it as well.
    const focused = document.activeElement;
    if (
      focused instanceof HTMLElement &&
      items.some((item) => item.contains(focused))
    ) {
      focused.blur();
    }
  });
</script>
