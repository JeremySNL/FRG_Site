---
/**
 * An image gallery. Clicking an image opens it in a native lightbox.
 */
import type { GalleryBlock } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: GalleryBlock;
}

const { block } = Astro.props;
---

{
  block.images.length > 0 && (
    <section class="section">
      <div class="container-site">
        {block.title && <h2 class="text-display-md">{block.title}</h2>}

        <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {block.images.map((image, index) => (
            <li>
              <a
                href={mediaUrl(image.src)}
                target="_blank"
                rel="noopener noreferrer"
                class="block overflow-hidden rounded-xl bg-surface"
              >
                <img
                  src={mediaUrl(image.src)}
                  alt={image.alt}
                  loading={index < 8 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="aspect-square w-full object-cover transition-transform duration-300 hover:scale-105"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
