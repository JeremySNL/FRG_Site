---
/**
 * The latest posts, rendered as a list of cards.
 */
import type { LatestPostsBlock } from '~/lib/blocks.ts';
import { getPosts } from '~/lib/content.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getUi } from '~/lib/ui.ts';
import { localePath, type Locale } from '~/lib/locales.ts';

interface Props {
  block: LatestPostsBlock;
  locale: Locale;
}

const { block, locale } = Astro.props;
const ui = getUi(locale);

const posts = (await getPosts(locale)).slice(0, block.limit);
---

{posts.length > 0 && (
  <section class="bg-white py-16 md:py-24">
    <div class="container-site">
      {block.title && <h2 class="text-display-md md:text-display-lg">{block.title}</h2>}

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border-2 border-brand-navy bg-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-brand-red hover:shadow-xl">
            {post.data.image && (
              <img
                src={mediaUrl(post.data.image)}
                alt={post.data.imageAlt ?? ''}
                loading="lazy"
                decoding="async"
                class="h-48 w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              <time
                datetime={post.data.date.toISOString()}
                class="font-alt text-xs uppercase tracking-[0.14em] text-brand-red"
              >
                {post.data.date.toLocaleDateString(locale, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              <h3 class="mt-3 font-display text-lg font-semibold text-brand-navy">
                <a
                  href={localePath(locale, `actualidades/${post.data.slug}`)}
                  class="transition-colors hover:text-brand-red"
                >
                  {post.data.title}
                </a>
              </h3>
              {post.data.excerpt && (
                <p class="mt-3 flex-1 text-sm leading-relaxed text-secondary">
                  {post.data.excerpt}
                </p>
              )}
              <a
                href={localePath(locale, `actualidades/${post.data.slug}`)}
                class="mt-5 inline-flex items-center gap-1 font-display text-sm font-semibold text-brand-red"
              >
                <span>{ui.readMore}</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href={localePath(locale, 'actualidades')} class="border-2 border-brand-navy px-6 py-3 font-display font-semibold text-brand-navy hover:bg-brand-navy hover:text-white">
          {ui.allPosts}
        </a>
      </div>
    </div>
  </section>
)}
