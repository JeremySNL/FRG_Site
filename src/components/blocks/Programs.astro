---
/**
 * The programs / areas of action grid.
 *
 * Programs have no detail page of their own yet, so each card links to the
 * "Programas y Proyectos" page — except when the grid is rendered on that
 * page, where the link would point to itself.
 */
import type { ProgramsBlock } from '~/lib/blocks.ts';
import { sectionClass } from '~/lib/blocks.ts';
import { getPrograms } from '~/lib/content.ts';
import { localePath, parseRoute } from '~/lib/locales.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getUi } from '~/lib/ui.ts';

interface Props {
  block: ProgramsBlock;
}

const { block } = Astro.props;
const { locale } = parseRoute(Astro.url.pathname);
const ui = getUi(locale);
const indexHref = localePath(locale, 'programas-y-proyectos');
const onIndex = Astro.url.pathname === indexHref;

const allPrograms = await getPrograms(locale);
const programs = allPrograms.filter((program) =>
  block.programs.includes(program.data.slug),
);

// The dark "featured" band on the home page is keyed to the title of the
// programs block (theme migration debt). Both language variants must match,
// until the block schema grows an explicit style option.
const featured =
  block.title === 'Programas que Transforman' || block.title === 'Programs that Transform';
---

{programs.length > 0 && (
  <section class={featured ? 'bg-brand-navy py-16 md:py-24' : sectionClass(block.surface, true)}>
    <div class="container-site">
      {(block.title || block.intro) && (
        <div class="mb-10 max-w-2xl">
          {block.title && (
            <h2 class={featured ? 'text-display-md md:text-display-lg text-white' : 'text-display-md md:text-display-lg'}>
              {block.title}
            </h2>
          )}
          {block.intro && <p class={featured ? 'mt-4 text-lg text-white/90' : 'mt-4 text-lg text-secondary'}>{block.intro}</p>}
        </div>
      )}

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {programs.map((program) => (
          <article class={featured ? 'group flex flex-col overflow-hidden rounded-2xl border-2 border-white bg-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-brand-red hover:shadow-2xl' : 'card group flex flex-col overflow-hidden p-0'}>
            {program.data.image && (
              <img
                src={mediaUrl(program.data.image)}
                alt={program.data.imageAlt ?? program.data.title}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3 class={featured ? 'text-display-xs text-brand-navy' : 'text-display-xs'}>{program.data.title}</h3>
              {program.data.summary && (
                <p class="mt-2 flex-1 text-base text-secondary">{program.data.summary}</p>
              )}
              {!onIndex && (
                <a
                  class={featured ? 'mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-red' : 'link-underline mt-6 inline-flex items-center gap-2 text-sm'}
                  href={indexHref}
                >
                  {ui.viewProgram}
                  <svg
                    aria-hidden="true"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M6 3L11 8L6 13"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
