---
/**
 * The team of the foundation, split into sections.
 *
 * The entries live in the `team` collection and each one names its `group`
 * (and, for country ambassadors, its `continent`); `src/lib/team.ts` turns
 * them into the sections drawn here. The presidency gets one large card,
 * directors and continental ambassadors a regular card, and the country
 * ambassadors a compact one so that twenty people do not read as a wall.
 */
import type { TeamBlock } from '~/lib/blocks.ts';
import { sectionClass } from '~/lib/blocks.ts';
import { getTeam } from '~/lib/content.ts';
import { groupTeam, type TeamGroup } from '~/lib/team.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getUi } from '~/lib/ui.ts';
import type { Locale } from '~/lib/locales.ts';

interface Props {
  block: TeamBlock;
  locale: Locale;
}

const { block, locale } = Astro.props;
const ui = getUi(locale);
const team = await getTeam(locale);
const sections = groupTeam(team, locale);

const headings: Record<TeamGroup, string> = {
  presidencia: ui.teamGroupPresidencia,
  direccion: ui.teamGroupDireccion,
  continental: ui.teamGroupContinental,
  nacional: ui.teamGroupNacional,
};

const intros: Partial<Record<TeamGroup, string>> = {
  direccion: ui.teamGroupDireccionIntro,
  continental: ui.teamGroupContinentalIntro,
  nacional: ui.teamGroupNacionalIntro,
};

const continentNames = {
  africa: ui.teamContinentAfrica,
  asia: ui.teamContinentAsia,
  america: ui.teamContinentAmerica,
  europa: ui.teamContinentEuropa,
  oceania: ui.teamContinentOceania,
};

/** One heading per group, even when the country ambassadors span continents. */
const groups = sections.reduce<TeamGroup[]>(
  (list, section) => (list.includes(section.group) ? list : [...list, section.group]),
  [],
);

const sectionId = (group: TeamGroup) => `equipo-${group}`;
---

<section class={sectionClass(block.surface)}>
  <div class="container-site">
    {block.title && <h2 class="text-display-md">{block.title}</h2>}
    {block.intro && <p class="mt-4 max-w-2xl text-lg text-secondary">{block.intro}</p>}

    {groups.length > 1 && (
      <nav aria-label={ui.teamSectionsNav} class="mt-8 flex flex-wrap gap-2">
        {groups.map((group) => (
          <a
            href={`#${sectionId(group)}`}
            class="rounded-full border border-accent/30 bg-white px-4 py-1.5 text-sm font-medium text-accent transition-colors hover:border-accent hover:bg-accent hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {headings[group]}
          </a>
        ))}
      </nav>
    )}

    {sections.length > 0 ? (
      <div class="mt-10 space-y-14">
        {groups.map((group) => (
          <section id={sectionId(group)} class="scroll-mt-28">
            <header class="mb-6">
              <div class="flex items-center gap-4">
                <span class="h-1.5 w-12 shrink-0 bg-brand-red" aria-hidden="true" />
                <h3 class="text-display-sm">{headings[group]}</h3>
              </div>
              {intros[group] && (
                <p class="mt-3 max-w-2xl text-secondary">{intros[group]}</p>
              )}
            </header>

            <div class="space-y-10">
              {sections
                .filter((section) => section.group === group)
                .map((section) => (
                  <div>
                    {section.continent && (
                      <h4 class="mb-4 font-display text-lg font-semibold text-brand-navy">
                        {continentNames[section.continent]}
                        <span class="ml-2 text-sm font-normal text-secondary">
                          ({section.members.length})
                        </span>
                      </h4>
                    )}

                    {group === 'presidencia' && (
                      <div class="grid gap-6">
                        {section.members.map((member) => (
                          <article class="card flex flex-col items-center gap-6 text-center md:flex-row md:text-left">
                            {member.data.image && (
                              <img
                                src={mediaUrl(member.data.image)}
                                alt={member.data.imageAlt ?? member.data.name}
                                loading="lazy"
                                decoding="async"
                                class="size-44 shrink-0 rounded-pill object-cover ring-4 ring-brand-navy"
                              />
                            )}
                            <div>
                              <h4 class="font-display text-2xl font-semibold">
                                {member.data.name}
                              </h4>
                              {member.data.role && (
                                <p class="mt-1 text-accent">{member.data.role}</p>
                              )}
                              {member.data.bio && (
                                <p class="mt-3 leading-relaxed text-secondary">
                                  {member.data.bio}
                                </p>
                              )}
                            </div>
                          </article>
                        ))}
                      </div>
                    )}

                    {(group === 'direccion' || group === 'continental') && (
                      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {section.members.map((member) => (
                          <article class="card text-center">
                            {member.data.image && (
                              <img
                                src={mediaUrl(member.data.image)}
                                alt={member.data.imageAlt ?? member.data.name}
                                loading="lazy"
                                decoding="async"
                                class="mx-auto size-32 rounded-pill object-cover"
                              />
                            )}
                            <h4 class="mt-5 font-display text-lg font-semibold">
                              {member.data.name}
                            </h4>
                            {member.data.role && (
                              <p class="mt-1 text-sm text-accent">{member.data.role}</p>
                            )}
                            {member.data.bio && (
                              <p class="mt-3 text-sm leading-relaxed text-secondary">
                                {member.data.bio}
                              </p>
                            )}
                          </article>
                        ))}
                      </div>
                    )}

                    {group === 'nacional' && (
                      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                        {section.members.map((member) => (
                          <article class="card p-4 text-center">
                            {member.data.image && (
                              <img
                                src={mediaUrl(member.data.image)}
                                alt={member.data.imageAlt ?? member.data.name}
                                loading="lazy"
                                decoding="async"
                                class="mx-auto size-20 rounded-pill object-cover"
                              />
                            )}
                            <h5 class="mt-3 font-display text-base leading-snug font-semibold">
                              {member.data.name}
                            </h5>
                            {member.data.role && (
                              <p class="mt-1 text-xs text-accent">{member.data.role}</p>
                            )}
                          </article>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <p class="mt-10 rounded-2xl border border-dashed border-muted bg-surface p-8 text-sm text-secondary">
        {ui.teamEmpty}
      </p>
    )}
  </div>
</section>
