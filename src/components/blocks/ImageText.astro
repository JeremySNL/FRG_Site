---
/**
 * Image paired with text and calls to action.
 */
import type { ImageTextBlock } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: ImageTextBlock;
}

const { block } = Astro.props;
const reverse = block.reverse ? 'lg:flex-row-reverse' : 'lg:flex-row';
---

<section class="section">
  <div class="container-site">
    <div class={`flex flex-col items-center gap-10 ${reverse} lg:gap-16`}>
      <div class="w-full lg:w-1/2">
        {block.image ? (
          <img
            src={mediaUrl(block.image)}
            alt={block.imageAlt ?? ''}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
          />
        ) : (
          <div class="aspect-[4/3] w-full rounded-3xl bg-surface"></div>
        )}
      </div>
      <div class="w-full lg:w-1/2">
        {block.title && (
          <h2 class="text-display-md md:text-display-lg text-balance">{block.title}</h2>
        )}
        {block.text && (
          <div
            class="prose-frg mt-6 text-lg leading-relaxed text-secondary"
            set:html={block.text}
          />
        )}
        {block.buttons.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-4">
            {block.buttons.map((button) => (
              <a href={button.href} class="btn-primary">
                {button.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
