---
/**
 * A row of counters ("20+ años de fundación", "15.000+ personas impactadas").
 */
import type { StatsBlock } from '~/lib/blocks.ts';

interface Props {
  block: StatsBlock;
}

const { block } = Astro.props;
---

{block.items.length > 0 && (
  <section class="section-tight bg-accent text-white">
    <div class="container-site">
      <dl class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
        {block.items.map((item) => (
          <div>
            <dt class="font-alt text-sm uppercase tracking-[0.14em] text-white/70">
              {item.label}
            </dt>
            <dd class="mt-2 font-display text-display-lg text-white">{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
