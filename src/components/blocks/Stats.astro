---
/**
 * Highlighted figures about the foundation's impact.
 */
import type { StatsBlock } from '~/lib/blocks.ts';
import { sectionClass } from '~/lib/blocks.ts';

interface Props {
  block: StatsBlock;
}

const { block } = Astro.props;
---

<section class={sectionClass(block.surface, true)}>
  <div class="container-site">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {block.items.map((item) => (
        <article class="rounded-2xl border border-muted bg-white px-6 py-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
          <p class="font-display text-display-md md:text-display-lg text-accent">
            {item.value}
          </p>
          <p class="mt-2 text-base font-medium text-secondary">{item.label}</p>
        </article>
      ))}
    </div>
  </div>
</section>
