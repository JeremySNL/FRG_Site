---
/**
 * The lead-capture forms.
 *
 * The field sets reproduce the WPForms definitions recovered from the
 * WordPress database (contact = 292, donation = 742, volunteering = 768).
 *
 * The forms post to a plain Astro endpoint (`/api/contact`, `/api/donar`,
 * `/api/voluntariado`) that validates the payload with Zod, verifies the
 * Cloudflare Turnstile token and notifies the team by e-mail. Nothing about
 * the donation is processed online: the form only starts a conversation.
 */
import type { FormBlock } from '~/lib/blocks.ts';
import { sectionClass } from '~/lib/blocks.ts';
import { ambassadorOption, donationOptions, volunteerOptions } from '~/lib/forms.ts';
import { getUi } from '~/lib/ui.ts';
import type { Locale } from '~/lib/locales.ts';
import { turnstileSiteKey } from '~/lib/turnstile-config.ts';

interface Props {
  block: FormBlock;
  locale: Locale;
}

const { block, locale } = Astro.props;
const ui = getUi(locale);

// Client-side copy travels through a data attribute instead of a per-locale
// dictionary in the script: every locale gets its own strings from the i18n
// table at render time.
const formCopy = {
  success: ui.form.success,
  error: ui.form.error,
  rateLimited: ui.form.rateLimited,
  invalidToken: ui.form.invalidToken,
  sending: ui.form.sending,
  required: ui.form.fieldRequired,
  email: ui.form.invalidEmail,
  // Not a status: the message a vacancy chip preloads into the textarea.
  vacancy: ui.form.vacancyPrefill,
};

const config = {
  contact: {
    action: '/api/contact/',
    title: ui.form.contactTitle,
    text: ui.form.contactText,
    options: [],
    optionLabel: '',
    optionPlaceholder: '',
  },
  donar: {
    action: '/api/donar/',
    title: ui.form.donateTitle,
    text: ui.form.donateText,
    options: donationOptions,
    optionLabel: ui.form.donationType,
    optionPlaceholder: ui.form.donationTypePlaceholder,
  },
  voluntariado: {
    action: '/api/voluntariado/',
    title: ui.form.volunteerTitle,
    text: ui.form.volunteerText,
    options: volunteerOptions,
    optionLabel: ui.form.volunteerType,
    optionPlaceholder: ui.form.volunteerTypePlaceholder,
  },
  newsletter: {
    action: '/api/newsletter/',
    title: ui.newsletterTitle,
    text: ui.newsletterText,
    options: [],
    optionLabel: '',
    optionPlaceholder: '',
  },
}[block.form];

const siteKey = turnstileSiteKey;
const hasOptions = config.options.length > 0;

/** The name of the multi-select field, so the endpoint knows what it holds. */
const optionField =
  block.form === 'donar'
    ? 'donationTypes'
    : block.form === 'voluntariado'
      ? 'collaborationTypes'
      : 'options';
---

<section class={sectionClass(block.surface)} id="formulario">
  <div class="container-site">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-display-md">{config.title}</h2>
      <p class="mt-4 text-lg text-secondary">{config.text}</p>

      <form
        class="mt-10 space-y-6 rounded-3xl border border-muted bg-white p-8"
        method="post"
        action={config.action}
        data-form={block.form}
        data-locale={locale}
        data-copy={JSON.stringify(formCopy)}
        novalidate
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label
              for={`${block.form}-name`}
              class="block font-display text-sm font-medium"
            >
              {ui.form.name} <span class="text-accent-hover">*</span>
            </label>
            <input
              id={`${block.form}-name`}
              name="name"
              type="text"
              required
              autocomplete="name"
              class="mt-2 w-full rounded-xl border border-muted px-4 py-3 text-base focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label
              for={`${block.form}-phone`}
              class="block font-display text-sm font-medium"
            >
              {ui.form.phone} <span class="text-accent-hover">*</span>
            </label>
            <input
              id={`${block.form}-phone`}
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              class="mt-2 w-full rounded-xl border border-muted px-4 py-3 text-base focus:border-accent focus:outline-none"
            />
          </div>

          <div>
            <label
              for={`${block.form}-email`}
              class="block font-display text-sm font-medium"
            >
              {ui.form.email}{' '}
              <span class="text-sm text-secondary">({ui.form.optional})</span>
            </label>
            <input
              id={`${block.form}-email`}
              name="email"
              type="email"
              autocomplete="email"
              class="mt-2 w-full rounded-xl border border-muted px-4 py-3 text-base focus:border-accent focus:outline-none"
            />
          </div>
        </div>

        {hasOptions && (
          <fieldset>
            <legend class="font-display text-sm font-medium">
              {config.optionLabel}
            </legend>
            <p class="mt-1 text-xs text-secondary">{ui.form.multipleHint}</p>
            <div class="mt-4 grid gap-2 sm:grid-cols-2">
              {config.options.map((option) => (
                <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-muted px-4 py-3 text-sm transition-colors hover:border-accent has-checked:border-accent has-checked:bg-surface">
                  <input
                    type="checkbox"
                    name={optionField}
                    value={option}
                    data-vacancy={option === ambassadorOption ? '' : undefined}
                    class="mt-0.5 size-4 shrink-0 accent-[var(--color-accent)]"
                  />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <div>
          <label
            for={`${block.form}-message`}
            class="block font-display text-sm font-medium"
          >
            {ui.form.message}{' '}
            <span class="text-sm text-secondary">({ui.form.optional})</span>
          </label>
          <textarea
            id={`${block.form}-message`}
            name="message"
            rows="5"
            class="mt-2 w-full rounded-xl border border-muted px-4 py-3 text-base focus:border-accent focus:outline-none"
          >
          </textarea>
        </div>

        <!-- Honeypot: real users never fill this in. -->
        <div class="hidden" aria-hidden="true">
          <label for={`${block.form}-website`}>Website</label>
          <input
            id={`${block.form}-website`}
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        {siteKey && (
          <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>
        )}

        <p class="min-h-6 text-sm" data-status role="status" aria-live="polite"></p>

        <button type="submit" class="btn-primary w-full sm:w-auto">
          {ui.form.submit}
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  interface FormCopy {
    success: string;
    error: string;
    rateLimited: string;
    invalidToken: string;
    sending: string;
    required: string;
    email: string;
    /** Template of the message a vacancy chip preloads. */
    vacancy: string;
  }

  /** Everything in `FormCopy` except the prefill template, which is not a status. */
  type Status = Exclude<keyof FormCopy, 'vacancy'>;

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) {
    const copy: FormCopy = (() => {
      try {
        return JSON.parse(form.dataset.copy ?? '') as FormCopy;
      } catch {
        return {
          success: '',
          error: '',
          rateLimited: '',
          invalidToken: '',
          sending: '',
          required: '',
          email: '',
          vacancy: '',
        };
      }
    })();
    const status = form.querySelector<HTMLElement>('[data-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    /**
     * The vacancy chips of the ambassadors block link here as
     * `?pais=España&continente=Europa#formulario`. Preselect the ambassador
     * option and write the country into the message, so the reader does not
     * have to find that checkbox among nine. Both fields stay editable.
     */
    const vacancyInput = form.querySelector<HTMLInputElement>('input[data-vacancy]');

    if (vacancyInput) {
      const params = new URLSearchParams(window.location.search);
      const country = params.get('pais')?.trim();
      const continent = params.get('continente')?.trim();

      if (country) {
        vacancyInput.checked = true;

        const message = form.querySelector<HTMLTextAreaElement>(
          'textarea[name="message"]',
        );

        if (message && continent && !message.value.trim()) {
          message.value = copy.vacancy
            .replace('{country}', country)
            .replace('{continent}', continent);
        }
      }
    }

    const setStatus = (kind: Status): void => {
      if (!status) return;
      status.textContent = copy[kind];
      status.classList.toggle('text-accent-hover', kind !== 'success');
      status.classList.toggle('text-accent', kind === 'success');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);

      if (!String(data.get('name') ?? '').trim()) {
        setStatus('required');
        return;
      }

      if (!String(data.get('phone') ?? '').trim()) {
        setStatus('required');
        return;
      }

      const email = String(data.get('email') ?? '').trim();
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setStatus('email');
        return;
      }

      const tokenField = form.querySelector<HTMLInputElement>(
        'input[name="cf-turnstile-response"]',
      );
      if (tokenField?.value) data.set('turnstileToken', tokenField.value);

      button?.setAttribute('disabled', 'disabled');
      setStatus('sending');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { accept: 'application/json' },
        });

        const result = (await response.json()) as { ok?: boolean; error?: string };

        if (result.ok) {
          setStatus('success');
          form.reset();
        } else if (result.error === 'rate-limited') {
          setStatus('rateLimited');
        } else if (result.error === 'invalid-token') {
          setStatus('invalidToken');
        } else {
          setStatus('error');
        }
      } catch {
        setStatus('error');
      } finally {
        button?.removeAttribute('disabled');
      }
    });
  }
</script>
