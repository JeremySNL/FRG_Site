---
/**
 * Goodwill Ambassadors organized by continent with a prominent
 * Continental General Ambassador and a grid of Country/Area Ambassadors below.
 */
import type { AmbassadorsBlock } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: AmbassadorsBlock;
}

const { block } = Astro.props;
---

<section id="continentes" class="bg-white py-16 md:py-24">
  <div class="container-site">
    {(block.title || block.intro) && (
      <div class="mb-12 max-w-3xl">
        {block.title && (
          <h2 class="text-display-md md:text-display-lg">{block.title}</h2>
        )}
        {block.intro && (
          <p class="mt-4 text-lg leading-relaxed text-secondary">
            {block.intro}
          </p>
        )}
      </div>
    )}

    <div class="space-y-16">
      {block.continents.map((continent) => (
        <article id={`continente-${continent.name.toLowerCase().replace(/\s+/g, '-')}`} class="space-y-8 scroll-mt-28">
          <header class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
              <span class="h-1.5 w-12 bg-brand-red"></span>
              <h3 class="text-display-sm md:text-display-md">{continent.name}</h3>
            </div>
          </header>

          <!-- Continental General Ambassador - prominent -->
          <div class="relative overflow-hidden rounded-3xl border-4 border-brand-navy bg-white p-6 shadow-xl md:p-12">
            <div class="relative grid items-center gap-8 md:grid-cols-[auto,1fr] md:gap-12">
              <div class="relative mx-auto md:mx-0">
                {continent.generalAmbassador.image ? (
                  <img
                    src={mediaUrl(continent.generalAmbassador.image)}
                    alt={
                      continent.generalAmbassador.imageAlt ??
                      continent.generalAmbassador.name
                    }
                    loading="lazy"
                    decoding="async"
                    class="relative h-48 w-48 rounded-full object-cover shadow-xl ring-4 ring-brand-navy md:h-64 md:w-64"
                  />
                ) : (
                  <div class="relative flex h-48 w-48 items-center justify-center rounded-full bg-brand-navy/10 shadow-xl ring-4 ring-brand-navy md:h-64 md:w-64">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="h-20 w-20 fill-brand-navy md:h-32 md:w-32"
                    >
                      <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="text-center md:text-left">
                <div class="mb-4 inline-flex items-center gap-2 rounded-none bg-brand-red px-5 py-2 text-xs font-bold uppercase tracking-[0.2em] text-white">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="h-4 w-4 fill-current"
                  >
                    <path d="M10 2 12.09 7.26H18l-4.545 3.3L15.545 16 10 12.7 4.455 16l1.09-5.44L1 7.26h5.91L10 2Z" />
                  </svg>
                  Embajador General Continental
                </div>
                <h4 class="text-display-sm md:text-display-lg">
                  {continent.generalAmbassador.name}
                </h4>
                {(continent.generalAmbassador.country ||
                  continent.generalAmbassador.role) && (
                  <p class="mt-3 text-xl font-medium text-accent">
                    {[continent.generalAmbassador.role, continent.generalAmbassador.country]
                      .filter(Boolean)
                      .join(' · ')}
                  </p>
                )}
                <p class="mt-4 text-base leading-relaxed text-secondary">
                  Representante principal y portavoz de la Fundación Rosario Gatón en {continent.name}, promoviendo la cooperación internacional, la solidaridad y el desarrollo sostenible.
                </p>
              </div>
            </div>
          </div>

          <!-- Country/Area Ambassadors grid -->
          {continent.ambassadors.length > 0 && (
            <div>
              <div class="mb-6 flex items-center gap-3">
                <h5 class="text-display-xs md:text-display-sm">
                  Embajadores por País / Área
                </h5>
                <div class="h-px flex-1 bg-brand-navy"></div>
              </div>
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {continent.ambassadors.map((ambassador) => (
                  <article class="group relative overflow-hidden rounded-2xl border-2 border-brand-navy bg-white p-6 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-brand-red hover:shadow-xl">
                    <div class="relative flex flex-col items-center text-center">
                      <div class="mb-4">
                        {ambassador.image ? (
                          <img
                            src={mediaUrl(ambassador.image)}
                            alt={ambassador.imageAlt ?? ambassador.name}
                            loading="lazy"
                            decoding="async"
                            class="h-24 w-24 rounded-full object-cover shadow-lg ring-2 ring-brand-navy"
                          />
                        ) : (
                          <div class="flex h-24 w-24 items-center justify-center rounded-full bg-brand-navy/10 shadow-lg ring-2 ring-brand-navy">
                            <svg
                              aria-hidden="true"
                              viewBox="0 0 24 24"
                              class="h-12 w-12 fill-brand-navy"
                            >
                              <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                            </svg>
                          </div>
                        )}
                      </div>
                      <h6 class="font-display text-lg font-semibold text-brand-navy">
                        {ambassador.name}
                      </h6>
                      {(ambassador.country || ambassador.area || ambassador.role) && (
                        <p class="mt-1 text-sm font-medium text-brand-red">
                          {[
                            ambassador.role,
                            ambassador.area || ambassador.country,
                          ]
                            .filter(Boolean)
                            .join(' · ')}
                        </p>
                      )}
                      {ambassador.country && ambassador.area && (
                        <p class="mt-1 text-xs text-secondary">
                          {ambassador.country}
                        </p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
