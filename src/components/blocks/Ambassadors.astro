---
/**
 * Goodwill Ambassadors organized by continent with a prominent
 * Continental General Ambassador and a grid of Country/Area Ambassadors below.
 */
import type { AmbassadorsBlock } from '~/lib/blocks.ts';
import { sectionClass } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: AmbassadorsBlock;
}

const { block } = Astro.props;
---

<section class={sectionClass(block.surface, false)}>
  <div class="container-site">
    {(block.title || block.intro) && (
      <div class="mb-12 max-w-3xl">
        {block.title && (
          <h2 class="text-display-md md:text-display-lg">{block.title}</h2>
        )}
        {block.intro && (
          <p class="mt-4 text-lg leading-relaxed text-secondary">
            {block.intro}
          </p>
        )}
      </div>
    )}

    <div class="space-y-16">
      {block.continents.map((continent) => (
        <article class="space-y-8">
          <header class="flex flex-col gap-2">
            <div class="flex items-center gap-3">
              <span class="h-1 w-10 rounded-full bg-accent"></span>
              <h3 class="text-display-sm md:text-display-md">{continent.name}</h3>
            </div>
            <p class="text-base text-secondary">
              Embajadores de Buena Voluntad por continente
            </p>
          </header>

          <!-- Continental General Ambassador - prominent -->
          <div class="relative overflow-hidden rounded-3xl border border-accent/20 bg-linear-to-br from-white via-tint to-tint-strong p-6 shadow-lg shadow-accent/10 md:p-10">
            <div
              aria-hidden="true"
              class="absolute -top-16 -right-16 h-48 w-48 rounded-full bg-accent/10 blur-3xl"
            ></div>
            <div class="relative grid items-center gap-6 md:grid-cols-[auto,1fr] md:gap-10">
              <div class="relative mx-auto md:mx-0">
                <div
                  aria-hidden="true"
                  class="absolute -inset-2 rounded-full bg-linear-to-br from-accent to-accent-hover opacity-20 blur-xl"
                ></div>
                {continent.generalAmbassador.image ? (
                  <img
                    src={mediaUrl(continent.generalAmbassador.image)}
                    alt={
                      continent.generalAmbassador.imageAlt ??
                      continent.generalAmbassador.name
                    }
                    loading="lazy"
                    decoding="async"
                    class="relative h-40 w-40 rounded-full object-cover shadow-xl shadow-accent/20 ring-4 ring-white md:h-56 md:w-56"
                  />
                ) : (
                  <div class="relative flex h-40 w-40 items-center justify-center rounded-full bg-white shadow-xl shadow-accent/20 ring-4 ring-white md:h-56 md:w-56">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="h-16 w-16 fill-accent/40 md:h-24 md:w-24"
                    >
                      <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="text-center md:text-left">
                <div class="mb-4 inline-flex items-center gap-2 rounded-pill bg-accent px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-white shadow-md shadow-accent/30">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="h-3.5 w-3.5 fill-current"
                  >
                    <path d="M10 2 12.09 7.26H18l-4.545 3.3L15.545 16 10 12.7 4.455 16l1.09-5.44L1 7.26h5.91L10 2Z" />
                  </svg>
                  Embajador General Continental
                </div>
                <h4 class="text-display-sm md:text-display-md">
                  {continent.generalAmbassador.name}
                </h4>
                {(continent.generalAmbassador.country ||
                  continent.generalAmbassador.role) && (
                  <p class="mt-2 text-lg text-secondary">
                    {[continent.generalAmbassador.role, continent.generalAmbassador.country]
                      .filter(Boolean)
                      .join(' · ')}
                  </p>
                )}
                <p class="mt-4 text-base text-secondary/80">
                  Representante principal en {continent.name}
                </p>
              </div>
            </div>
          </div>

          <!-- Country/Area Ambassadors grid -->
          {continent.ambassadors.length > 0 && (
            <div>
              <div class="mb-6 flex items-center gap-3">
                <h5 class="text-display-xs md:text-display-sm">
                  Embajadores por País / Área
                </h5>
                <div class="h-px flex-1 bg-gradient-to-r from-accent/30 to-transparent"></div>
              </div>
              <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {continent.ambassadors.map((ambassador) => (
                  <article class="group relative overflow-hidden rounded-2xl border border-accent/10 bg-white p-6 shadow-md shadow-black/5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-accent/10">
                    <div
                      aria-hidden="true"
                      class="absolute -top-10 -right-10 h-24 w-24 rounded-full bg-tint transition-transform duration-300 group-hover:scale-110"
                    ></div>
                    <div class="relative flex flex-col items-center text-center">
                      <div class="mb-4">
                        {ambassador.image ? (
                          <img
                            src={mediaUrl(ambassador.image)}
                            alt={ambassador.imageAlt ?? ambassador.name}
                            loading="lazy"
                            decoding="async"
                            class="h-24 w-24 rounded-full object-cover shadow-lg shadow-accent/15 ring-2 ring-white"
                          />
                        ) : (
                          <div class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-tint to-tint-strong shadow-lg shadow-accent/15 ring-2 ring-white">
                            <svg
                              aria-hidden="true"
                              viewBox="0 0 24 24"
                              class="h-12 w-12 fill-accent/40"
                            >
                              <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                            </svg>
                          </div>
                        )}
                      </div>
                      <h6 class="font-display text-lg font-semibold">
                        {ambassador.name}
                      </h6>
                      {(ambassador.country || ambassador.area || ambassador.role) && (
                        <p class="mt-1 text-sm text-secondary">
                          {[
                            ambassador.role,
                            ambassador.area || ambassador.country,
                          ]
                            .filter(Boolean)
                            .join(' · ')}
                        </p>
                      )}
                      {ambassador.country && ambassador.area && (
                        <p class="mt-1 text-xs text-secondary/70">
                          {ambassador.country}
                        </p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
