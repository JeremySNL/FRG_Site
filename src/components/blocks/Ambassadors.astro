---
/**
 * Goodwill ambassadors by continent.
 *
 * The section has to stay short, so each continent is one compact row for its
 * continental ambassador, one scrolling strip for its country ambassadors and
 * the open seats as chips. The full list lives on the team page, which the
 * closing link points to. Vacancies are data (`openCountries`) and render as
 * chips that lead to the volunteering form instead of one card per empty seat;
 * a continent with nothing to show is skipped instead of leaving an empty
 * heading.
 *
 * A continent can combine the three states at once: a continental ambassador,
 * country ambassadors and open countries. When the first country ambassadors
 * arrive, the strip is already there and only the data changes.
 */
import type { AmbassadorPerson, AmbassadorsBlock } from '~/lib/blocks.ts';
import { localePath, parseRoute } from '~/lib/locales.ts';
import { getUi } from '~/lib/ui.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: AmbassadorsBlock;
}

const { block } = Astro.props;
const { locale } = parseRoute(Astro.url.pathname);
const ui = getUi(locale);

/**
 * The badge above the name carries the role. The content can word it for the
 * person (for instance "Embajadora" instead of the interface's "Embajador"),
 * so the badge prefers that and falls back to the shared label.
 */
function generalRole(person: AmbassadorPerson): string {
  return person.role || ui.ambassadorGeneralRole;
}

/**
 * The line under the name: the role plus where the person serves. A role such
 * as "Embajador de Buena Voluntad en Camerún" already names the country, so
 * the place is only appended when the role does not contain it.
 */
function roleLine(person: AmbassadorPerson): string {
  const place = person.area || person.country;
  const role = person.role;
  const placeInRole = role && place && role.toLowerCase().includes(place.toLowerCase());

  return [role, placeInRole ? undefined : place].filter(Boolean).join(' · ');
}

/**
 * Where a vacancy chip sends the reader: the volunteering form, with the
 * country already written into the message.
 */
function vacancyHref(continent: string, country?: string): string {
  const base = localePath(locale, 'voluntariado');
  if (!country) return `${base}#formulario`;

  const query = new URLSearchParams({ pais: country, continente: continent });
  return `${base}?${query.toString()}#formulario`;
}

/** A continent with no ambassador and no vacancy would only print a heading. */
const continents = block.continents.filter(
  (continent) =>
    continent.generalAmbassador !== undefined ||
    continent.ambassadors.length > 0 ||
    continent.openCountries.length > 0,
);
---

<section id="continentes" class="bg-white py-16 md:py-24">
  <div class="container-site">
    {(block.title || block.intro) && (
      <div class="mb-10 max-w-3xl">
        {block.title && (
          <h2 class="text-display-md md:text-display-lg">{block.title}</h2>
        )}
        {block.intro && (
          <p class="mt-4 text-lg leading-relaxed text-secondary">{block.intro}</p>
        )}
      </div>
    )}

    <div class="divide-y divide-brand-navy/15 border-y border-brand-navy/15">
      {continents.map((continent) => (
        <article
          id={`continente-${continent.name.toLowerCase().replace(/\s+/g, '-')}`}
          class="scroll-mt-28 py-8"
        >
          <header class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-3">
            <span class="h-1.5 w-12 shrink-0 bg-brand-red" aria-hidden="true" />
            <h3 class="text-display-sm md:text-display-md">{continent.name}</h3>
            {!continent.generalAmbassador && (
              <span class="rounded-full border border-dashed border-brand-navy/40 px-3 py-1 text-xs font-semibold tracking-wide text-brand-navy/70 uppercase">
                {ui.ambassadorGeneralOpen}
              </span>
            )}
          </header>

          {/* The continental ambassador: one compact row, no repeated blurb. */}
          {continent.generalAmbassador && (
            <div class="flex items-center gap-4 rounded-2xl border-2 border-brand-navy bg-white p-4 shadow-md md:gap-6 md:p-5">
              {continent.generalAmbassador.image ? (
                <img
                  src={mediaUrl(continent.generalAmbassador.image)}
                  alt={
                    continent.generalAmbassador.imageAlt ??
                    continent.generalAmbassador.name
                  }
                  loading="lazy"
                  decoding="async"
                  class="size-20 shrink-0 rounded-full object-cover shadow-md ring-4 ring-brand-navy md:size-24"
                />
              ) : (
                <div class="flex size-20 shrink-0 items-center justify-center rounded-full bg-brand-navy/10 shadow-md ring-4 ring-brand-navy md:size-24">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="size-10 fill-brand-navy"
                  >
                    <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                  </svg>
                </div>
              )}
              <div class="min-w-0">
                <div class="mb-2 inline-flex items-center gap-2 bg-brand-red px-3 py-1.5 text-[0.7rem] font-bold tracking-[0.15em] text-white uppercase">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="size-3.5 fill-current"
                  >
                    <path d="M10 2 12.09 7.26H18l-4.545 3.3L15.545 16 10 12.7 4.455 16l1.09-5.44L1 7.26h5.91L10 2Z" />
                  </svg>
                  {generalRole(continent.generalAmbassador)}
                </div>
                <h4 class="font-display text-xl font-semibold text-brand-navy md:text-2xl">
                  {continent.generalAmbassador.name}
                </h4>
                {continent.generalAmbassador.country && (
                  <p class="text-base font-medium text-accent">
                    {continent.generalAmbassador.country}
                  </p>
                )}
              </div>
            </div>
          )}

          {/*
              Country/area ambassadors: one strip that scrolls sideways once the
              cards no longer fit. It is focusable so keyboard users can scroll
              it with the arrow keys.
            */}
          {continent.ambassadors.length > 0 && (
            <div
              role="region"
              aria-label={`${ui.ambassadorAreaHeading} · ${continent.name}`}
              tabindex="0"
              class="-mx-4 mt-4 flex snap-x snap-proximity gap-3 overflow-x-auto px-4 pt-1 pb-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red md:-mx-0 md:px-0"
            >
              {continent.ambassadors.map((ambassador) => (
                <article class="w-44 shrink-0 snap-start rounded-xl border-2 border-brand-navy bg-white p-3 text-center shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-red hover:shadow-md">
                  {ambassador.image ? (
                    <img
                      src={mediaUrl(ambassador.image)}
                      alt={ambassador.imageAlt ?? ambassador.name}
                      loading="lazy"
                      decoding="async"
                      class="mx-auto mb-2 size-14 rounded-full object-cover ring-2 ring-brand-navy"
                    />
                  ) : (
                    <div class="mx-auto mb-2 flex size-14 items-center justify-center rounded-full bg-brand-navy/10 ring-2 ring-brand-navy">
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        class="size-7 fill-brand-navy"
                      >
                        <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                      </svg>
                    </div>
                  )}
                  <h5 class="font-display text-sm leading-snug font-semibold text-brand-navy">
                    {ambassador.name}
                  </h5>
                  {roleLine(ambassador) && (
                    <p class="mt-1 text-xs leading-snug font-medium text-brand-red">
                      {roleLine(ambassador)}
                    </p>
                  )}
                </article>
              ))}
            </div>
          )}

          {/*
              Open countries. Each chip opens the volunteering form with that
              country already written in the message, so the twenty-four empty
              seats work as an invitation instead of looking unfinished.
            */}
          {continent.openCountries.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-3 rounded-2xl border border-dashed border-brand-navy/30 bg-surface px-4 py-4 md:px-6">
              <span class="font-display text-xs font-bold tracking-[0.15em] text-brand-navy/60 uppercase">
                {ui.ambassadorVacancies}
              </span>
              {continent.openCountries.map((country) => (
                <a
                  href={vacancyHref(continent.name, country)}
                  aria-label={ui.ambassadorVacancyCta.replace('{country}', country)}
                  class="rounded-full border border-brand-navy/25 bg-white px-3 py-1 text-sm text-brand-navy transition-colors hover:border-brand-red hover:text-brand-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red"
                >
                  {country}
                </a>
              ))}
              <a
                href={vacancyHref(continent.name)}
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand-red hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red sm:ml-auto"
              >
                {ui.ambassadorVacancyCtaGeneric}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          )}
        </article>
      ))}
    </div>

    <p class="mt-8 text-center">
      <a
        href={`${localePath(locale, 'nuestro-equipo')}#equipo-nacional`}
        class="inline-flex items-center gap-2 font-display font-semibold text-brand-red hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red"
      >
        {ui.ambassadorSeeTeam}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>
