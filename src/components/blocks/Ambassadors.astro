---
/**
 * Goodwill ambassadors by continent.
 *
 * The section has to stay short. Today there is one continental ambassador and
 * twenty-four open seats, so drawing a card per seat filled several screens
 * with the words "to be assigned". Vacancies are therefore data
 * (`openCountries`) and render as chips that lead to the volunteering form; a
 * continent with nothing to show is skipped instead of leaving an empty
 * heading.
 *
 * A continent can combine the three states at once: a continental ambassador,
 * country ambassadors and open countries. When the first country ambassadors
 * arrive, the grid is already there and only the data changes.
 */
import type { AmbassadorPerson, AmbassadorsBlock } from '~/lib/blocks.ts';
import { localePath, parseRoute } from '~/lib/locales.ts';
import { getUi } from '~/lib/ui.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: AmbassadorsBlock;
}

const { block } = Astro.props;
const { locale } = parseRoute(Astro.url.pathname);
const ui = getUi(locale);

/**
 * The badge above the name already reads "Continental General Ambassador", so
 * repeating the same role on the line below only adds noise: that line keeps
 * the country, and the role only when the content gives it a different one.
 */
function generalMeta(person: AmbassadorPerson): string {
  const role =
    person.role && person.role !== ui.ambassadorGeneralRole ? person.role : undefined;
  return [role, person.country].filter(Boolean).join(' · ');
}

/**
 * Where a vacancy chip sends the reader: the volunteering form, with the
 * country already written into the message.
 */
function vacancyHref(continent: string, country?: string): string {
  const base = localePath(locale, 'voluntariado');
  if (!country) return `${base}#formulario`;

  const query = new URLSearchParams({ pais: country, continente: continent });
  return `${base}?${query.toString()}#formulario`;
}

/** A continent with no ambassador and no vacancy would only print a heading. */
const continents = block.continents.filter(
  (continent) =>
    continent.generalAmbassador !== undefined ||
    continent.ambassadors.length > 0 ||
    continent.openCountries.length > 0,
);
---

<section id="continentes" class="bg-white py-16 md:py-24">
  <div class="container-site">
    {(block.title || block.intro) && (
      <div class="mb-10 max-w-3xl">
        {block.title && (
          <h2 class="text-display-md md:text-display-lg">{block.title}</h2>
        )}
        {block.intro && (
          <p class="mt-4 text-lg leading-relaxed text-secondary">{block.intro}</p>
        )}
      </div>
    )}

    <div class="divide-y divide-brand-navy/15 border-y border-brand-navy/15">
      {continents.map((continent) => (
        <article
          id={`continente-${continent.name.toLowerCase().replace(/\s+/g, '-')}`}
          class="scroll-mt-28 py-10"
        >
          <header class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-3">
            <span class="h-1.5 w-12 shrink-0 bg-brand-red" aria-hidden="true" />
            <h3 class="text-display-sm md:text-display-md">{continent.name}</h3>
            {!continent.generalAmbassador && (
              <span class="rounded-full border border-dashed border-brand-navy/40 px-3 py-1 text-xs font-semibold tracking-wide text-brand-navy/70 uppercase">
                {ui.ambassadorGeneralOpen}
              </span>
            )}
          </header>

          {/* The continental ambassador, the only seat with a face today. */}
          {continent.generalAmbassador && (
            <div class="rounded-2xl border-2 border-brand-navy bg-white p-6 shadow-lg md:p-8">
              <div class="grid items-center gap-6 md:grid-cols-[auto_1fr] md:gap-10">
                <div class="mx-auto md:mx-0">
                  {continent.generalAmbassador.image ? (
                    <img
                      src={mediaUrl(continent.generalAmbassador.image)}
                      alt={
                        continent.generalAmbassador.imageAlt ??
                        continent.generalAmbassador.name
                      }
                      loading="lazy"
                      decoding="async"
                      class="h-40 w-40 rounded-full object-cover shadow-lg ring-4 ring-brand-navy md:h-52 md:w-52"
                    />
                  ) : (
                    <div class="flex h-40 w-40 items-center justify-center rounded-full bg-brand-navy/10 shadow-lg ring-4 ring-brand-navy md:h-52 md:w-52">
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        class="h-16 w-16 fill-brand-navy md:h-24 md:w-24"
                      >
                        <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="text-center md:text-left">
                  <div class="mb-3 inline-flex items-center gap-2 bg-brand-red px-4 py-2 text-xs font-bold tracking-[0.2em] text-white uppercase">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      class="h-4 w-4 fill-current"
                    >
                      <path d="M10 2 12.09 7.26H18l-4.545 3.3L15.545 16 10 12.7 4.455 16l1.09-5.44L1 7.26h5.91L10 2Z" />
                    </svg>
                    {ui.ambassadorGeneralRole}
                  </div>
                  <h4 class="text-display-sm md:text-display-md">
                    {continent.generalAmbassador.name}
                  </h4>
                  {(continent.generalAmbassador.country ||
                    continent.generalAmbassador.role) && (
                    <p class="mt-2 text-lg font-medium text-accent">
                      {generalMeta(continent.generalAmbassador)}
                    </p>
                  )}
                  <p class="mt-3 text-base leading-relaxed text-secondary">
                    {ui.ambassadorGeneralIntro.replace('{continent}', continent.name)}
                  </p>
                </div>
              </div>
            </div>
          )}

          {/* Country/area ambassadors: empty today, ready for the first ones. */}
          {continent.ambassadors.length > 0 && (
            <div class="mt-8">
              <div class="mb-4 flex items-center gap-3">
                <h5 class="text-display-xs md:text-display-sm">
                  {ui.ambassadorAreaHeading}
                </h5>
                <div class="h-px flex-1 bg-brand-navy/30" aria-hidden="true" />
              </div>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {continent.ambassadors.map((ambassador) => (
                  <article class="rounded-2xl border-2 border-brand-navy bg-white p-5 shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-brand-red hover:shadow-lg">
                    <div class="flex flex-col items-center text-center">
                      {ambassador.image ? (
                        <img
                          src={mediaUrl(ambassador.image)}
                          alt={ambassador.imageAlt ?? ambassador.name}
                          loading="lazy"
                          decoding="async"
                          class="mb-3 h-20 w-20 rounded-full object-cover shadow-md ring-2 ring-brand-navy"
                        />
                      ) : (
                        <div class="mb-3 flex h-20 w-20 items-center justify-center rounded-full bg-brand-navy/10 shadow-md ring-2 ring-brand-navy">
                          <svg
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            class="h-10 w-10 fill-brand-navy"
                          >
                            <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5Z" />
                          </svg>
                        </div>
                      )}
                      <h6 class="font-display text-lg font-semibold text-brand-navy">
                        {ambassador.name}
                      </h6>
                      {(ambassador.country || ambassador.area || ambassador.role) && (
                        <p class="mt-1 text-sm font-medium text-brand-red">
                          {[ambassador.role, ambassador.area || ambassador.country]
                            .filter(Boolean)
                            .join(' · ')}
                        </p>
                      )}
                      {ambassador.country && ambassador.area && (
                        <p class="mt-1 text-xs text-secondary">{ambassador.country}</p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

          {/*
              Open countries. Each chip opens the volunteering form with that
              country already written in the message, so the twenty-four empty
              seats work as an invitation instead of looking unfinished.
            */}
          {continent.openCountries.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-3 rounded-2xl border border-dashed border-brand-navy/30 bg-surface px-4 py-4 md:px-6">
              <span class="font-display text-xs font-bold tracking-[0.15em] text-brand-navy/60 uppercase">
                {ui.ambassadorVacancies}
              </span>
              {continent.openCountries.map((country) => (
                <a
                  href={vacancyHref(continent.name, country)}
                  aria-label={ui.ambassadorVacancyCta.replace('{country}', country)}
                  class="rounded-full border border-brand-navy/25 bg-white px-3 py-1 text-sm text-brand-navy transition-colors hover:border-brand-red hover:text-brand-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red"
                >
                  {country}
                </a>
              ))}
              <a
                href={vacancyHref(continent.name)}
                class="inline-flex items-center gap-1 text-sm font-semibold text-brand-red hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red sm:ml-auto"
              >
                {ui.ambassadorVacancyCtaGeneric}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
