---
/**
 * A grid of cards. Used for the areas of action, the ways to collaborate and
 * the contact details.
 */
import type { CardsBlock } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getUi } from '~/lib/ui.ts';
import type { Locale } from '~/lib/locales.ts';

interface Props {
  block: CardsBlock;
  locale: Locale;
}

const { block, locale } = Astro.props;
const ui = getUi(locale);
---

{
  block.items.length > 0 && (
    <section class="section">
      <div class="container-site">
        {block.title && (
          <h2 class="text-display-md">{block.title}</h2>
        )}
        {block.intro && (
          <p class="mt-4 max-w-2xl text-lg text-secondary">{block.intro}</p>
        )}

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {block.items.map((item) => (
            <article class="card flex flex-col">
              {item.image && (
                <img
                  src={mediaUrl(item.image)}
                  alt={item.imageAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                  class="mb-5 h-48 w-full rounded-xl object-cover"
                />
              )}
              <h3 class="font-display text-lg font-semibold">{item.title}</h3>
              {item.text && (
                <p class="mt-2 flex-1 text-sm leading-relaxed text-secondary">
                  {item.text}
                </p>
              )}
              {item.href && (
                <a
                  href={item.href}
                  class="mt-5 inline-flex items-center gap-1 font-display text-sm font-medium text-accent hover:text-accent-hover"
                >
                  <span class="link-underline">{ui.readMore}</span>
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
