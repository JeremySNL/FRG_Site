---
/**
 * Simple card grid with titles, text, optional images, icons and links.
 */
import type { CardsBlock } from '~/lib/blocks.ts';
import { sectionClass } from '~/lib/blocks.ts';
import { parseRoute } from '~/lib/locales.ts';
import { iconPath } from '~/lib/icons.ts';
import { mediaUrl } from '~/lib/site.ts';
import { getUi } from '~/lib/ui.ts';

interface Props {
  block: CardsBlock;
}

const { block } = Astro.props;
const ui = getUi(parseRoute(Astro.url.pathname).locale);
---

<section class={block.title === 'Áreas de acción' ? 'bg-white py-16 md:py-24' : sectionClass(block.surface)}>
  <div class="container-site">
    {(block.title || block.intro) && (
      <div class="mb-10 max-w-2xl">
        {block.title && (
          <h2 class="text-display-md md:text-display-lg">{block.title}</h2>
        )}
        {block.intro && <p class="mt-4 text-lg text-secondary">{block.intro}</p>}
      </div>
    )}

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {block.items.map((item) => {
        const icon = iconPath(item.icon);

        const content = (
          <>
            {item.image && (
              <img
                src={mediaUrl(item.image)}
                alt={item.imageAlt ?? item.title}
                loading="lazy"
                decoding="async"
                class="mb-5 aspect-video w-full rounded-xl object-cover"
              />
            )}
            {icon && (
              <span
                aria-hidden="true"
                class="mb-5 inline-flex size-11 items-center justify-center rounded-none bg-brand-navy text-white"
              >
                <svg viewBox="0 0 24 24" class="size-5 fill-current">
                  <path d={icon} />
                </svg>
              </span>
            )}
            <h3 class="text-display-xs text-brand-navy">{item.title}</h3>
            {item.text && <p class="mt-2 text-base text-secondary">{item.text}</p>}
            {item.href && (
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-red">
                {ui.readMore}
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M6 3L11 8L6 13"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </span>
            )}
          </>
        );

        return item.href ? (
          <a class="group block rounded-2xl border-2 border-brand-navy bg-white p-6 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-brand-red hover:shadow-xl" href={item.href}>
            {content}
          </a>
        ) : (
          <article class="group rounded-2xl border-2 border-brand-navy bg-white p-6 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:border-brand-red hover:shadow-xl">{content}</article>
        );
      })}
    </div>
  </div>
</section>
