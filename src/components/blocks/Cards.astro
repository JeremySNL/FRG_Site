---
/**
 * Simple card grid with titles, text and optional images/links.
 */
import type { CardsBlock } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: CardsBlock;
}

const { block } = Astro.props;
---

<section class="section">
  <div class="container-site">
    {(block.title || block.intro) && (
      <div class="mb-10 max-w-2xl">
        {block.title && <h2 class="text-display-md md:text-display-lg">{block.title}</h2>}
        {block.intro && <p class="mt-4 text-lg text-secondary">{block.intro}</p>}
      </div>
    )}

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {block.items.map((item) => {
        const content = (
          <>
            {item.image && (
              <img
                src={mediaUrl(item.image)}
                alt={item.imageAlt ?? item.title}
                loading="lazy"
                decoding="async"
                class="mb-5 aspect-video w-full rounded-xl object-cover"
              />
            )}
            <h3 class="text-display-xs">{item.title}</h3>
            {item.text && <p class="mt-2 text-base text-secondary">{item.text}</p>}
            {item.href && (
              <span class="link-underline mt-4 inline-flex items-center gap-2 text-sm">
                Saber más
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M6 3L11 8L6 13"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
            )}
          </>
        );

        return item.href ? (
          <a class="card-link group" href={item.href}>
            {content}
          </a>
        ) : (
          <article class="card group">{content}</article>
        );
      })}
    </div>
  </div>
</section>
