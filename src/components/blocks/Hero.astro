---
/**
 * The hero of a page: title, lead paragraph, slogans and calls to action.
 */
import type { HeroBlock } from '~/lib/blocks.ts';
import { mediaUrl } from '~/lib/site.ts';

interface Props {
  block: HeroBlock;
}

const { block } = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="container-site grid items-center gap-10 py-16 md:grid-cols-2 md:py-24">
    <div>
      {block.eyebrow && (
        <p class="font-alt text-sm font-medium uppercase tracking-[0.18em] text-accent">
          {block.eyebrow}
        </p>
      )}

      <h1 class="mt-4 text-display-lg md:text-display-2xl text-balance">{block.title}</h1>

      {block.slogans && block.slogans.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          {block.slogans.map((slogan) => (
            <li class="font-alt text-sm font-medium text-accent">{slogan}</li>
          ))}
        </ul>
      )}

      {block.text && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-secondary">
          {block.text}
        </p>
      )}

      {block.buttons.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-4">
          {block.buttons.map((button, index) => (
            <a
              href={button.href}
              class:list={[index === 0 ? 'btn-primary' : 'btn-outline']}
            >
              {button.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="relative">
      {block.image ? (
        <img
          src={mediaUrl(block.image)}
          alt={block.imageAlt ?? ''}
          loading="eager"
          decoding="async"
          class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
        />
      ) : (
        <div class="aspect-[4/3] w-full rounded-3xl bg-surface"></div>
      )}
      <div
        aria-hidden="true"
        class="absolute -bottom-6 -left-6 hidden h-32 w-32 rounded-full bg-accent/10 md:block"
      >
      </div>
    </div>
  </div>
</section>
